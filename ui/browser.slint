// Lwow browser shell — chrome drawn by Slint; page content is rendered by
// WebView2 child windows positioned over the content region (src/webviews).
// NOTE: exported component must INHERIT Window (a Window cannot be a child).

import { LineEdit } from "std-widgets.slint";

struct TabData {
    id: int,
    title: string,
    url: string,
    pinned: bool,
    loading: bool,
    playing_audio: bool,
}

component TabStrip {
    in property <[TabData]> tabs;
    in property <int> active-index;
    callback open-new-tab();
    callback close-tab(int);
    callback select-tab(int);

    HorizontalLayout {
        padding: 4dp;
        spacing: 4dp;
        height: 40dp;

        ListView {
            orientation: horizontal;

            for tab[i] in tabs: Rectangle {
                width: 180dp;
                height: 32dp;
                border-radius: 8dp;
                background: i == active-index
                    ? #1A2129
                    : (ta.has-hover ? #161B22 : transparent);

                ta := TouchArea {
                    clicked => { root.select-tab(tab.id); }
                }

                if tab.playing_audio: Rectangle {
                    x: 8dp;
                    y: (parent.height - 10dp) / 2;
                    width: 10dp;
                    height: 10dp;
                    border-radius: 5dp;
                    background: #7C5CFF;
                }

                Text {
                    x: 24dp;
                    width: parent.width - 44dp;
                    vertical-alignment: center;
                    overflow: elide;
                    color: i == active-index ? #F4F6F8 : #8B95A1;
                    font-size: 12px;
                    text: tab.title == "" ? "Nova aba" : tab.title;
                }

                if !tab.pinned: Rectangle {
                    x: parent.width - 24dp;
                    y: (parent.height - 16dp) / 2;
                    width: 16dp;
                    height: 16dp;
                    border-radius: 4dp;
                    background: close-ta.has-hover ? #2A323C : transparent;

                    Text {
                        text: "×";
                        font-size: 12px;
                        color: #8B95A1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-ta := TouchArea {
                        clicked => { root.close-tab(tab.id); }
                    }
                }
            }
        }

        // New tab button
        Rectangle {
            width: 32dp;
            border-radius: 8dp;
            background: new-tab-ta.has-hover ? #161B22 : transparent;

            Text {
                text: "+";
                font-size: 18px;
                color: #8B95A1;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            new-tab-ta := TouchArea {
                clicked => { root.open-new-tab(); }
            }
        }
    }
}

component ToolBar {
    in-out property <string> address;
    callback navigate(string);
    callback go-back();
    callback go-forward();
    callback reload();

    HorizontalLayout {
        spacing: 6dp;
        padding: 4dp;
        height: 44dp;

        Rectangle {
            width: 32dp;
            height: 32dp;
            border-radius: 6dp;
            background: back-ta.has-hover ? #1A2129 : transparent;
            Text { text: "‹"; font-size: 18px; color: #F4F6F8; horizontal-alignment: center; vertical-alignment: center; }
            back-ta := TouchArea { clicked => { root.go-back(); } }
        }

        Rectangle {
            width: 32dp;
            height: 32dp;
            border-radius: 6dp;
            background: fwd-ta.has-hover ? #1A2129 : transparent;
            Text { text: "›"; font-size: 18px; color: #F4F6F8; horizontal-alignment: center; vertical-alignment: center; }
            fwd-ta := TouchArea { clicked => { root.go-forward(); } }
        }

        Rectangle {
            width: 32dp;
            height: 32dp;
            border-radius: 6dp;
            background: reload-ta.has-hover ? #1A2129 : transparent;
            Text { text: "⟳"; font-size: 16px; color: #F4F6F8; horizontal-alignment: center; vertical-alignment: center; }
            reload-ta := TouchArea { clicked => { root.reload(); } }
        }

        // Omnibar
        Rectangle {
            border-radius: 999dp;
            background: #10161D;
            border-width: 1dp;
            border-color: address-input.has-focus ? #7C5CFF : #2A323C;

            address-input := LineEdit {
                x: 12dp;
                width: parent.width - 24dp;
                y: (parent.height - 32dp) / 2;
                height: 32dp;
                placeholder-text: "Pesquisar ou digitar um endereço";
                text <=> root.address;
                accepted(text) => { root.navigate(text); }
            }
        }
    }
}

export component BrowserWindow inherits Window {
    in-out property <string> address;
    in property <[TabData]> tabs;
    in property <int> active-index;

    callback navigate(string);
    callback go-back();
    callback go-forward();
    callback reload();
    callback open-new-tab();
    callback close-tab(int);
    callback select-tab(int);

    title: "Lwow";
    background: #0F1419;
    preferred-width: 1280px;
    preferred-height: 800px;

    VerticalLayout {
        TabStrip {
            tabs: root.tabs;
            active-index: root.active-index;
            open-new-tab => { root.open-new-tab(); }
            close-tab(id) => { root.close-tab(id); }
            select-tab(id) => { root.select-tab(id); }
        }

        ToolBar {
            address <=> root.address;
            navigate(u) => { root.navigate(u); }
            go-back => { root.go-back(); }
            go-forward => { root.go-forward(); }
            reload => { root.reload(); }
        }

        // Content region: the active tab's WebView2 child is positioned over
        // this area by the Rust layer (src/webviews). Drawn only as fallback.
        Rectangle { background: #0B0F13; }
    }
}
